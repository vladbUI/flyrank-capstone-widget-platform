# Copy to .env to override. docker compose works without a .env (these are the defaults).

# Postgres (local container only)
POSTGRES_USER=widget
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=widgets
DATABASE_URL=postgres://widget:change-me-local-only@localhost:5432/widgets

PORT=3000
# Base URL written into embed snippets
PUBLIC_BASE_URL=http://localhost:3000
# Set to 1 (or a CIDR) only when running behind a reverse proxy you control
TRUST_PROXY=false

# Geo enrichment: "mock" = deterministic fake providers (for probes), "real" = ip-api.com -> ipapi.co
GEO_MODE=mock
GEO_TIMEOUT_MS=1500

# Exposes /dev/toggles to switch geo providers / email down. NEVER enable in production.
DEV_TOOLS=true

# Rate limits on the public submission endpoint
RATE_LIMIT_IP_WIDGET_MAX=20
RATE_LIMIT_IP_WIDGET_WINDOW_MS=10000
RATE_LIMIT_WIDGET_MAX=100
RATE_LIMIT_WIDGET_WINDOW_MS=60000

# Demo tenant API keys created by `npm run seed` (stored hashed). Replace for anything real.
DEMO_KEY_A=demo-key-tenant-a
DEMO_KEY_B=demo-key-tenant-b
